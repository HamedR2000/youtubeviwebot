# Copy to .env and adjust. All values are optional -- defaults live in config.py.

# Where downloads/outputs/OAuth state are stored (default: reaction_bot/workdir).
REACTION_WORK_DIR=

# Fraction of the 9:16 canvas the source clip fills (top of frame); the rest
# is the reaction caption panel. Keep well under 1.0 -- see README.md.
REACTION_SOURCE_HEIGHT_RATIO=0.6

# Cap on composed clip length, seconds.
REACTION_MAX_CLIP_SECONDS=58

# OAuth client downloaded from Google Cloud Console (see README.md).
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_TOKEN_FILE=

# private | unlisted | public -- never defaults to public.
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_DEFAULT_CATEGORY_ID=23
